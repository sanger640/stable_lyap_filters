diff --git a/fignet/_compat.py b/fignet/_compat.py
new file mode 100644
index 0000000..56101ee
--- /dev/null
+++ b/fignet/_compat.py
@@ -0,0 +1,30 @@
+"""Replacements for heavy optional dependencies (added for stable_lyap_filters).
+
+torch_scatter.scatter(reduce="sum", dim=0) -> index_add_; pytorch3d's
+corresponding_points_alignment (no weights, no scaling) -> batched Kabsch.
+"""
+from collections import namedtuple
+
+import torch
+
+Alignment = namedtuple("Alignment", ["R", "T", "s"])
+
+
+def scatter(src, index, dim=0, dim_size=None, reduce="sum"):
+    if dim != 0 or reduce != "sum":
+        raise NotImplementedError("only dim=0, reduce='sum' is used by fignet")
+    size = int(index.max()) + 1 if dim_size is None else dim_size
+    out = torch.zeros((size, *src.shape[1:]), dtype=src.dtype, device=src.device)
+    return out.index_add_(0, index.long(), src)
+
+
+def corresponding_points_alignment(X, Y):
+    """Batched rigid fit with X[i] @ R[i] + T[i] ~= Y[i] (pytorch3d convention)."""
+    x_mean, y_mean = X.mean(1, keepdim=True), Y.mean(1, keepdim=True)
+    covariance = (X - x_mean).transpose(1, 2) @ (Y - y_mean)
+    U, _, Vh = torch.linalg.svd(covariance)
+    sign = torch.sign(torch.linalg.det(U @ Vh))
+    E = torch.diag_embed(torch.stack([torch.ones_like(sign), torch.ones_like(sign), sign], -1))
+    R = U @ E @ Vh
+    T = (y_mean - x_mean @ R).squeeze(1)
+    return Alignment(R, T, torch.ones(X.shape[0], dtype=X.dtype, device=X.device))
