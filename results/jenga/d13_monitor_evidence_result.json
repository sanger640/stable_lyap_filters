      "d3_directory": "results/jenga/d3_data",
      "d12_directory": "results/jenga/d12_coverage_data",
      "groups": {
        "fit": 511,
        "episode_validation": 139,
        "configuration_validation": 132,
        "joint_validation": 50
      },
      "normalizers": "fit groups only",
      "task_failure_alarm_or_object_role_labels_used": false
    },
    "inputs": {
      "channels": "current generic 61-D physical state and six pairs of raw 8-step action chunks",
      "causal_history": false,
      "reason_history_excluded": "isolate output-interface causality; exact causal event history already failed D9c/D11/D12",
      "endpoint_symmetric": true,
      "level_order_invariant_group_readout": true
    },
    "continuous_targets": {
      "dimension": 4,
      "order": [
        "early_boundary_delta_bic",
        "full_boundary_delta_bic",
        "commitment_delta_bic",
        "persistence_delta_bic"
      ],
      "boundary": "unchanged v0 scaling-law BIC difference over all six refinement levels",
      "commitment": "unchanged v0 narrowest-pair whole-trajectory commitment BIC difference",
      "persistence": "unchanged v0 narrowest-pair late-hold persistence BIC difference",
      "transform": "sign(x) * log1p(abs(x)), then per-channel fit-only mean/std normalization",
      "decision": "inverse-transform and use the unchanged zero sign; no fitted threshold",
      "final_alarm_supervision": false
    },
    "arms": {
      "curve_baseline": "frozen D12 deterministic checkpoint; recompute all four evidence values from its predicted curves",
      "direct_evidence": "same D9b state/action pair encoder with an invariant four-value evidence head",
      "joint": "same encoder with both D9b curve reconstruction and four-value direct evidence heads"
    },
    "frozen_curve_baseline": {
      "result": "results/jenga/d12_ladder_result.json",
      "result_sha256": "51b14e1a652adfb56bcc1f98cb938e161571222ac2c50bb96aa1210a330c5330",
