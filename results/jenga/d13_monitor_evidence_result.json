    },
    "model": {
      "hidden": 128,
      "heads": 4,
      "layers": 2,
      "action_horizon": 8,
      "curve_steps": 39
    },
    "optimization": {
      "pilot_seed": 1,
      "replication_seeds_if_an_arm_passes_both_axes": [
        2,
        3
      ],
      "steps": 5000,
      "group_batch_size": 32,
      "optimizer": "AdamW",
      "initial_learning_rate": 0.001,
      "final_learning_rate": 1e-05,
      "schedule": "CosineAnnealingLR",
      "gradient_clip": 1.0,
      "direct_loss": "mean normalized transformed evidence MSE",
      "joint_loss": "evidence MSE plus the six unchanged equally weighted D9b amplitude/shape losses",
      "checkpoint_selection": "fixed final step only",
      "execution": "one sequential GPU arm at a time"
    },
    "primary_validation_axes": [
      "episode_validation",
      "configuration_validation"
    ],
    "gate_on_each_primary_axis": {
      "normalized_evidence_mse_no_worse_than_curve_baseline": true,
      "mean_channel_sign_agreement_no_worse_than_curve_baseline": true,
      "boundary_added_positive_reduction": 0.1,
      "final_added_positive_reduction": 0.1,
      "maximum_boundary_recall_loss": 0.05,
      "maximum_final_recall_loss": 0.05,
      "endpoint_and_level_symmetry_max_abs": 1e-05
    },
    "decision": {
      "pass_both_axes": "replicate the passing arm with seeds 2 and 3 before any DEV run",
      "otherwise": "do not tune on validation; if both direct interfaces fail, stop this privileged Jenga encoder family",
      "joint_validation": "diagnostic only",
      "dev_and_test": "remain closed for every outcome"
    }
  },
